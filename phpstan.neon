includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 7
    paths:
        - src
        - tests/unit
    excludePaths:
        - vendor
        # Codeception-backed integration suite + its support/bootstrap: the actor
        # pattern, _generated helpers, and craft\test framework magic aren't
        # statically analysable. The unit suite (tests/unit) stays analysed.
        - tests/integration
        - tests/_support
    bootstrapFiles:
        - vendor/autoload.php
        - vendor/craftcms/cms/bootstrap/console.php
    ignoreErrors:
        # stimmt/craft-mcp stays optional. Its attributes are read
        # reflectively and the package is not installed for analysis.
        # McpTool itself comes in with Craft 5.12's mcp/sdk dependency.
        - '#stimmt\\craft\\Mcp\\#'
